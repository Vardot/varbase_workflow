{
  "name": "varbase_workflow",
  "description": "Provides a toolkit for robust, quick, and enterprise content moderation features.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:build": "webpack --progress --config webpack.config.build.js",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "eslint --ext .js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "eslint --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Varbase Workflow",
    "Workflow",
    "Moderation",
    "Content Planner",
    "Scheduler"
  ],
  "author": "Vardot",
  "dependencies": {
    "@cucumber/cucumber": "10.0.1",
    "@cucumber/pretty-formatter": "1.0.0",
    "@vardot/varbase-e2e": "^2.0.4",
    "playwright": "1.60.0",
    "tsx": "4.22.1"
  },
  "resolutions": {
    "@cucumber/cucumber": "10.0.1",
    "@cucumber/pretty-formatter": "1.0.0",
    "playwright": "1.60.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "clean-webpack-plugin": "^4.0.0",
    "cspell": "^8.16.1",
    "css-loader": "^5.2.7",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "file-loader": "^5.0.2",
    "img-loader": "^4.0.0",
    "mini-css-extract-plugin": "^0.11.3",
    "postcss": "^8.5.3",
    "postcss-loader": "^6.2.1",
    "postcss-perfectionist": "^2.3.9",
    "prettier": "^3.5.3",
    "sass": "^1.71.1",
    "sass-loader": "^12.3.0",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.2",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1",
    "webpack-remove-empty-scripts": "^0.7.1"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.9.3"
}
