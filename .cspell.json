{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore"
  ],
  "words": [
    "varbase",
    "Varbase",
    "Vardot",
    "vardot",
    "phpcs",
    "phpcbf",
    "drupal",
    "Drupal",
    "workflow",
    "Workflow",
    "moderation",
    "Moderation",
    "scheduler",
    "Scheduler",
    "jsonapi",
    "api",
    "langcode",
    "metatag",
    "isset",
    "sprintf",
    "Symfony",
    "subqueue",
    "endfor",
    "loadjs",
    "unpublishing",
    "preg",
    "pathinfo",
    "twig",
    "kanban",
    "planner",
    "Scaned",
    "importConfigsFromScanedDirectory"
  ]
}
